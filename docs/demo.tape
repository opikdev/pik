Output docs/images/demo.gif
Set Shell zsh
Set FontSize 20
Set Width 1500
Set Height 720
Set Padding 32
Set Margin 0
Set WindowBar Colorful
Set TypingSpeed 55ms
Set Theme { "name": "midnight", "background": "#1b1c1f", "foreground": "#dad9d4", "cursor": "#a3bfa8", "selection": "#2c2d31", "black": "#1b1c1f", "brightBlack": "#6b6a66", "red": "#d98c8c", "brightRed": "#e6a3a3", "green": "#a3bfa8", "brightGreen": "#bcd4c0", "yellow": "#d9c48c", "brightYellow": "#e6d6a3", "blue": "#8ca8d9", "brightBlue": "#a3bce6", "magenta": "#c49cd9", "brightMagenta": "#d4b3e6", "cyan": "#8cc4c4", "brightCyan": "#a3d6d6", "white": "#dad9d4", "brightWhite": "#f5f5f2" }

Hide
Type "export PS1='%F{#a3bfa8}%~%f $ '; clear" Enter
Sleep 500ms
Show

Sleep 600ms
Type "pik new" Sleep 300ms Enter
Sleep 1.8s
Down Sleep 450ms Down Sleep 450ms Up Sleep 450ms Up Sleep 600ms
Enter
Sleep 900ms
Ctrl+U
Type "my-api" Sleep 500ms Enter
Sleep 1.4s
Enter
Sleep 900ms
Type "opikdev" Sleep 500ms Enter
Sleep 1.4s
Sleep 900ms Type "n"
Sleep 2.5s
Type "cd my-api && ls" Sleep 300ms Enter
Sleep 3.5s
